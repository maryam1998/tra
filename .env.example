# ============================================================
# AI Autonomous Financial Advisor — Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ============================================================

# ---- Bitpin (portfolio / balance / crypto market) ----
BITPIN_API_KEY=
BITPIN_SECRET_KEY=
BITPIN_BASE_URL=https://api.bitpin.org

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# AI Agent — multi-provider fallback chain
# ============================================================
# AIAgent tries providers in this order and uses the first one that
# answers successfully; if one is rate-limited/down/misconfigured it
# just falls through to the next. Remove/reorder names as you like.
# Only providers that are USABLE are actually tried:
#   - most need an API key below (leave blank to skip them)
#   - ovhcloud, llm7 and kilocode have permanent free anonymous tiers
#     and work with NO key at all — they're included by default
# If every provider in the list is unusable or fails, the system
# automatically drops to a transparent rule-based fallback (no AI).
AI_PROVIDER_PRIORITY=anthropic,groq,openrouter,google_gemini,mistral,nvidia_nim,zai,huggingface,cloudflare,ollama_cloud,aionlabs,cohere,siliconflow,ovhcloud,llm7,kilocode,modelscope

# --- Anthropic Claude --- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Groq --- https://console.groq.com/keys (free, no card)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter --- https://openrouter.ai/keys (17 free ":free" models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Google Gemini --- https://aistudio.google.com/app/apikey (free tier)
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# --- Mistral AI --- https://console.mistral.ai/api-keys ($10/mo free credits)
MISTRAL_API_KEY=
# Verify the exact model slug in your Mistral console — table names like
# "Mistral Small 4" are display names, not always the literal API id.
MISTRAL_MODEL=mistral-small-latest

# --- NVIDIA NIM --- https://build.nvidia.com/explore/discover (free w/ dev program)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Z AI / Zhipu (GLM) --- https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash

# --- Hugging Face router --- https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# --- Cloudflare Workers AI --- https://dash.cloudflare.com/profile/api-tokens
# Needs BOTH an account id and an API token; free tier = 10,000 neurons/day.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Ollama Cloud --- https://ollama.com/settings/keys
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# --- Aion Labs --- https://www.aionlabs.ai/app/api-keys/ (15 RPM, 20K TPD)
AIONLABS_API_KEY=
AIONLABS_MODEL=aion-labs/aion-3.0-mini

# --- Cohere --- https://dashboard.cohere.com/api-keys (1,000 calls/mo, non-commercial)
COHERE_API_KEY=
COHERE_MODEL=command-r

# --- SiliconFlow --- https://cloud.siliconflow.cn/account/ak (needs identity verification)
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B

# --- OVHcloud AI Endpoints --- permanent free ANONYMOUS tier, no key needed
# (2 requests/min per IP per model). Leave the key blank; it just works.
OVHCLOUD_API_KEY=
OVHCLOUD_MODEL=Meta-Llama-3_3-70B-Instruct

# --- LLM7.io --- anonymous tier needs no key (10 RPM / 60 req-hr).
# A free token from https://token.llm7.io just raises the limits.
LLM7_API_KEY=
LLM7_MODEL=gpt-oss:20b

# --- Kilo Code --- https://app.kilo.ai — free pool, NO API key at all
KILOCODE_MODEL=kilo-auto/free

# --- ModelScope --- https://modelscope.cn/my/myaccesstoken (needs Alibaba Cloud + real-name verification)
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B

# ---- Optional market-data providers ----
# Crypto OHLCV fallback / cross-check (CoinGecko needs no key for basic use)
COINGECKO_API_KEY=
# Stocks (Twelve Data, Alpha Vantage, or yfinance-free — pick what you have)
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Forex & Gold (Twelve Data covers both; metals-api as an alternative for gold)
METALS_API_KEY=
# News
CRYPTOPANIC_API_KEY=
NEWS_API_KEY=

# ---- Watchlists (comma-separated) ----
WATCHLIST_CRYPTO=BTC_IRT,ETH_IRT,USDT_IRT
WATCHLIST_STOCKS=AAPL,MSFT,NVDA
WATCHLIST_FOREX=EUR/USD,GBP/USD,USD/JPY
WATCHLIST_GOLD=XAU/USD

# ---- Scheduler ----
SCAN_INTERVAL_MINUTES=15
CANDLE_TIMEFRAME=1h
CANDLE_LOOKBACK=200

# ---- Risk management (independent of AI — hard limits) ----
MAX_RISK_PER_TRADE_PCT=1.0
MAX_LEVERAGE=3
MIN_LIQUIDATION_BUFFER_MULT=2.0
MAX_PORTFOLIO_EXPOSURE_PCT=30.0
MIN_OPPORTUNITY_SCORE=70

# ---- Alerting ----
ALERT_COOLDOWN_HOURS=6

# ---- Mode ----
# true = never place any order, only analyze & alert (REQUIRED for now)
DRY_RUN_ONLY=true
